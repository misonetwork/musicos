{
  "name": "@musicos/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for MusicOS on Sui",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@mysten/sui": "^1.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@mysten/sui": "^1.0.0"
  },
  "keywords": [
    "sui",
    "blockchain",
    "music",
    "nft",
    "royalties"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/studio-mirai/musicos.git",
    "directory": "packages/sdk"
  }
}
